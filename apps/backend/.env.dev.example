NODE_ENV=development

AWS_ACCESS_KEY=<access-key>
AWS_ACCESS_KEY_SECRET=<access-key-secret>
AWS_PRIVATE_MEDIA_BUCKET=<bucket-name>
AWS_PUBLIC_MEDIA_BUCKET=<bucket-name>
PUBLIC_MEDIA_BASE_URL=https://public-media-dev.imssystems.tech

MONGO_URL=<your_mongo_db_url>
DATABASE_NAME=<your_db_name>
CLIENT_URL=http://localhost:3000

ACCESS_TOKEN_SECRET=secret
ACCESS_TOKEN_EXPIRY=1d

REFRESH_TOKEN_SECRET=secret
REFRESH_TOKEN_EXPIRY=30d
INVITATION_TOKEN_EXPIRY=5d

JWT_KEY=secret
REGISTRATION_TOKEN_EXPIRY=10m
RECOVERY_TOKEN_EXPIRY=10m
QUOTATION_TOKEN_EXPIRY=604800

RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX=1000

# OpenAI — required. Used by CV extraction and by the AI agent.
OPENAI_API_KEY=<your_openai_api_key>
# Embeddings for hybrid job search. 1536 dimensions — must match numDimensions
# in the job_vector_index definition (src/scripts/ensure-search-indexes.ts).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# AI agent
AGENT_MODEL=gpt-4o
AGENT_MAX_STEPS=6
AGENT_HISTORY_LIMIT=20
# Token brakes. AGENT_MAX_TOKENS caps one answer, AGENT_TOOL_RESULT_MAX_CHARS caps
# one tool result, and AGENT_CONTEXT_BUDGET_TOKENS is the backstop that keeps a
# request inside the model's window. Lower the budget when pointing at a gateway
# whose model has a smaller context than gpt-4o's 128k.
AGENT_MAX_TOKENS=1500
AGENT_TOOL_RESULT_MAX_CHARS=8000
AGENT_CONTEXT_BUDGET_TOKENS=60000
AGENT_RATE_LIMIT_WINDOW_MS=60000
AGENT_RATE_LIMIT_MAX=10
# Unset => api.openai.com. Set to an OpenAI-compatible gateway to switch providers.
# AGENT_LLM_BASE_URL=

EMAIL_SENDER=info@interface.io
EMAIL_HOST=<your_email_host>
EMAIL_PORT=<your_email_port>
EMAIL_USERNAME=<your_email_username>
EMAIL_PASSWORD=<your_email_password>

# Redis - leave everything unset to use the Redis bundled inside the backend image.
# Set REDIS_URL for a managed instance (rediss:// enables TLS), or the discrete vars below.
# REDIS_URL=rediss://user:pass@my-cache.example.com:6380/0
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_TLS=false

GOOGLE_API_KEY=<your_google_api_key>

ADMIN_USER_EMAIL=<email>
ADMIN_USER_PASSWORD=<password>

# kanban settings
KANBAN_REBALANCE_BASE_GAP=1
KANBAN_MIN_RANK_GAP=0.0005
KANBAN_EDGE_RANK_GAP=1

LOG_LEVEL=debug