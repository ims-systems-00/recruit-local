# Root .env — build-time only, read by docker-compose.yml for interpolation.
# Copy to .env and fill in. Runtime config still lives in apps/*/.env.
#
# These are NEXT_PUBLIC_*, so they are inlined into the client bundle and are public
# by definition. Do NOT put NEXTAUTH_SECRET or any server-side secret here — those
# stay in apps/frontend/.env, which compose loads at runtime via env_file and which
# is deliberately kept out of the Docker build context.

# Public origin the browser talks to (TLS terminated upstream, forwarded to nginx).
PUBLIC_URL=https://recruit-local.imssystems.tech

# Sanity — required; the frontend build fails without them.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Optional.
NEXT_PUBLIC_APP_BRAND=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
